# Legal Matcher .env template (copy as .env.legal-matcher when executing)
# Values below are safe defaults for local docker-compose as per IMPLEMENTATION_PLAN.md

# Qdrant connection
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=laws_corpus
QDRANT_CREATE_IF_MISSING=true

# Embedding model
MODEL_NAME=BAAI/bge-m3
DEVICE=cpu
MAX_SEQ_LENGTH=512

# Service runtime
PORT=8001
LEGAL_LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

# Persistence / cache
DATABASE_URL=postgresql+psycopg://audit:auditpw@db:5432/auditdb
REDIS_URL=redis://redis:6379/0

# Matching defaults
TOP_K=5
MIN_SCORE=0.50
STRONG_MATCH_THRESHOLD=0.85
MEDIUM_MATCH_THRESHOLD=0.70
